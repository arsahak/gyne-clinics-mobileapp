{
  "expo": {
    "name": "GyneClinics",
    "slug": "gyneclinics-mobile",
    "version": "1.0.0",
    "scheme": "gyneclinics",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.gyneclinics.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#d13a8b"
      },
      "package": "com.gyneclinics.mobile",
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-asset",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow GyneClinics to access your photos so you can choose a profile picture or attach an image.",
          "cameraPermission": "Allow GyneClinics to use your camera so you can take a profile picture."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "tsconfigPaths": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "apiUrl": "http://localhost:5000"
    }
  }
}
