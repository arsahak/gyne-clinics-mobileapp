{
  "expo": {
    "name": "GyneX",
    "slug": "gyneclinics-mobile",
    "version": "1.0.0",
    "scheme": "gyneclinics",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#804898"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.gyneclinics.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.gyneclinics.mobile",
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#804898"
        }
      ],
      "expo-asset",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow GyneX to access your photos so you can choose a profile picture or attach an image.",
          "cameraPermission": "Allow GyneX to use your camera so you can take a profile picture."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow GyneX to use your location so consultation pricing can be matched to your region."
        }
      ],
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "",
          "enableGooglePay": false
        }
      ],
      [
        "@twilio/video-react-native-sdk",
        {
          "cameraPermission": "Allow GyneX to use your camera for video consultations with your doctor.",
          "microphonePermission": "Allow GyneX to use your microphone for video consultations with your doctor."
        }
      ],
      "expo-build-properties"
    ],
    "experiments": {
      "typedRoutes": true,
      "tsconfigPaths": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "apiUrl": "https://api.gyneclinics.com"
    }
  }
}
