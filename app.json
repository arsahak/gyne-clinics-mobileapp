{
  "expo": {
    "name": "GyneClinics",
    "slug": "gyneclinics-mobile",
    "version": "1.0.0",
    "scheme": "gyneclinics",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#d13a8b"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.gyneclinics.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#d13a8b"
      },
      "package": "com.gyneclinics.mobile",
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#d13a8b"
        }
      ],
      "expo-asset",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow GyneClinics to access your photos so you can choose a profile picture or attach an image.",
          "cameraPermission": "Allow GyneClinics to use your camera so you can take a profile picture."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow GyneClinics to use your location so consultation pricing can be matched to your region."
        }
      ],
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "",
          "enableGooglePay": false
        }
      ],
      [
        "@twilio/video-react-native-sdk",
        {
          "cameraPermission": "Allow GyneClinics to use your camera for video consultations with your doctor.",
          "microphonePermission": "Allow GyneClinics to use your microphone for video consultations with your doctor."
        }
      ],
      "expo-build-properties"
    ],
    "experiments": {
      "typedRoutes": true,
      "tsconfigPaths": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "apiUrl": "http://localhost:8000"
    }
  }
}
