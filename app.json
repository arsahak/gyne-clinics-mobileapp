{
  "expo": {
    "name": "Gyne",
    "slug": "gynex",
    "owner": "gyneclinics-ltd",
    "version": "1.0.0",
    "scheme": "gyneclinics",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#804898"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.gyneclinics.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.gyneclinics.mobile",
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#804898"
        }
      ],
      "expo-asset",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Gyne to access your photos so you can choose a profile picture or attach an image.",
          "cameraPermission": "Allow Gyne to use your camera for video consultations with your doctor and to take a profile picture."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Gyne to use your location so consultation pricing can be matched to your region."
        }
      ],
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "",
          "enableGooglePay": true
        }
      ],
      [
        "@twilio/video-react-native-sdk",
        {
          "cameraPermission": "Allow Gyne to use your camera for video consultations with your doctor and to take a profile picture.",
          "microphonePermission": "Allow Gyne to use your microphone for video consultations with your doctor."
        }
      ],
      "expo-build-properties"
    ],
    "experiments": {
      "typedRoutes": true,
      "tsconfigPaths": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "apiUrl": "https://api.gyneclinics.com",
      "eas": {
        "projectId": "65541340-44e8-47f5-8a4c-5443f12f8e1d"
      }
    }
  }
}
